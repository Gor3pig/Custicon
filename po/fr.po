msgstr "Icône modifiée depuis Nautilus"

msgid "Icon file missing"
msgstr "Fichier d’icône manquant"

msgid "Metadata unreadable"
msgstr "Métadonnées illisibles"

msgid "This folder no longer exists."
msgstr "Ce dossier n’existe plus."

msgid "This icon was replaced from Nautilus: Custicon no longer touches it."
msgstr ""
"Cette icône a été remplacée depuis Nautilus : Custicon n’y touche plus."

msgid "The icon file of this folder is missing."
msgstr "Le fichier d’icône de ce dossier est manquant."

msgid "The metadata of this folder cannot be read."
msgstr "Les métadonnées de ce dossier ne peuvent pas être lues."

msgid "Take Back the Custicon Icon"
msgstr "Reprendre l’icône Custicon"

msgid "Regenerate the Icon"
msgstr "Régénérer l’icône"

