[Desktop Entry]
Type=Application
Name=Custicon
Comment=Customize folder icons in your desktop environment
Exec=custicon %F
Icon=io.github.gor3pig.Custicon
Terminal=false
StartupNotify=true
Categories=Utility;FileTools;GTK;
Keywords=folder;icon;customize;pictogram;nautilus;nemo;caja;dolphin;file manager;
MimeType=inode/directory;
