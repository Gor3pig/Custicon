      <image type="source" width="1000" height="768">https://gor3pig.github.io/Custicon/screenshots/en-badge.png</image>
      <image xml:lang="fr" type="source" width="1000" height="768">https://gor3pig.github.io/Custicon/screenshots/fr-badge.png</image>
      <caption>A small colored badge in a corner of the folder</caption>
