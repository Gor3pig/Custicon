      <caption>Choose a pictogram, a color and a position, with a live preview</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="1000" height="720">https://gor3pig.github.io/Custicon/screenshots/en-phosphor.png</image>
      <image xml:lang="fr" type="source" width="1000" height="720">https://gor3pig.github.io/Custicon/screenshots/fr-phosphor.png</image>
      <caption>Thousands of pictograms: icon theme, Phosphor, emoji and brand logos</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="1000" height="720">https://gor3pig.github.io/Custicon/screenshots/en-tint.png</image>
      <image xml:lang="fr" type="source" width="1000" height="720">https://gor3pig.github.io/Custicon/screenshots/fr-tint.png</image>
      <caption>Tint the folder and keep its shading</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="1000" height="720">https://gor3pig.github.io/Custicon/screenshots/en-choosing.png</image>
      <image xml:lang="fr" type="source" width="1000" height="720">https://gor3pig.github.io/Custicon/screenshots/fr-choosing.png</image>
      <caption>Customize or restore several folders at once</caption>
