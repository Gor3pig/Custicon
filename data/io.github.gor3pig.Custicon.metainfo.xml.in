<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gor3pig.Custicon</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name translate="no">Custicon</name>
  <summary>Customize the icon of a folder in Nautilus</summary>
  <description>
    <p>
      Custicon adds a pictogram to the icon of a folder, like the Documents or Music folders have.
      The pictogram is placed on the real folder icon of your current icon theme, so the result
      follows your theme.
    </p>
    <ul>
      <li>Choose a pictogram from your icon theme, or use your own SVG or PNG file</li>
      <li>Let the color be chosen automatically, or set the color, the size and the position yourself</li>
      <li>See the result live before applying it</li>
      <li>Remove an icon at any time: the folder gets back the icon it had before</li>
      <li>Regenerate every icon after a change of icon theme</li>
      <li>The content of your folders is never modified</li>
    </ul>
    <p>
      Custicon only needs to read your home folder, to see the real location of the folders you choose.
      It has no access to the network, and the content of a folder is never written.
    </p>
  </description>

  <developer id="io.github.gor3pig">
    <name translate="no">Gor3pig</name>
  </developer>

  <launchable type="desktop-id">io.github.gor3pig.Custicon.desktop</launchable>
  <provides>
    <binary>custicon</binary>
  </provides>

  <url type="homepage">https://github.com/Gor3pig/Custicon</url>
  <url type="vcs-browser">https://github.com/Gor3pig/Custicon</url>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="1.1.0" date="2026-11-13">
      <description>
        <p>Finer controls, remembered settings and a more compact list.</p>
        <ul>
          <li>The size and position sliders move by half a percent and use the available width</li>
          <li>The appearance you applied is proposed again for the next folders you add, and can still be changed</li>
          <li>The list of customized folders uses smaller icons</li>
          <li>Custicon explains how to allow access to the home folder when it is missing</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-11-13">
      <description>
        <p>The first stable version of Custicon.</p>
        <ul>
          <li>Put a pictogram on the real folder icon of your current icon theme</li>
          <li>Choose a pictogram from your icon theme, or use your own SVG or PNG file</li>
          <li>Let the color be chosen automatically, or set the color, the size and the position yourself</li>
          <li>See the result live before applying it</li>
          <li>Remove an icon at any time: the folder gets back the icon it had before</li>
          <li>Regenerate every icon after a change of icon theme</li>
          <li>The content of your folders is never modified</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
