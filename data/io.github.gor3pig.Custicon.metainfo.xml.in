      <image type="source" width="1000" height="720">https://gor3pig.github.io/Custicon/screenshots/en-choosing.png</image>
      <image xml:lang="fr" type="source" width="1000" height="720">https://gor3pig.github.io/Custicon/screenshots/fr-choosing.png</image>
      <caption>Customize or restore several folders at once</caption>
    </screenshot>
