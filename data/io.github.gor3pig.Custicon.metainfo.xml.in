      <image xml:lang="fr" type="source" width="1000" height="720">https://gor3pig.github.io/Custicon/screenshots/fr-phosphor.png</image>
      <caption>Thousands of pictograms: icon theme, Phosphor, emoji and brand logos</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="1000" height="720">https://gor3pig.github.io/Custicon/screenshots/en-tint.png</image>
      <image xml:lang="fr" type="source" width="1000" height="720">https://gor3pig.github.io/Custicon/screenshots/fr-tint.png</image>
      <caption>Tint the folder and keep its shading</caption>
    </screenshot>
