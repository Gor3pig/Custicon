{
  "id": "io.github.gor3pig.Custicon",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "custicon",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--nosocket=x11",
    "--device=dri",
    "--filesystem=home",
    "--talk-name=org.gtk.vfs.Metadata",
    "--talk-name=org.gtk.vfs.Daemon"
  ],
  "cleanup": [
    "/share/doc",
    "/share/man"
  ],
  "modules": [
    {
      "name": "custicon",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "path": "..",
          "branch": "main"
        }
      ]
    }
  ]
}
